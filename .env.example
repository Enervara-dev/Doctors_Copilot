# Clinical Consultation Copilot — environment configuration
#
# Copy this file to `.env` and fill in the blanks. `.env` is git-ignored and
# loaded automatically (python-dotenv) by both services below.

# ─────────────────────────────────────────────────────────────────────────
# Shared — read by both app.main (audio pipeline) and copilot_api
# ─────────────────────────────────────────────────────────────────────────

# JWT signing key. NOT optional for anything beyond a throwaway local test:
# copilot_api refuses to start on the placeholder value below, because it is
# public (shipped in app/core/config.py) and would let anyone mint a valid
# token for any consultation.
CLINICAL_COPILOT_JWT_SECRET_KEY=production-jwt-secret-key-change-me
CLINICAL_COPILOT_JWT_ALGORITHM=HS256

# Queue backpressure for the audio ingestion buffer.
CLINICAL_COPILOT_QUEUE_MAX_SIZE=100
CLINICAL_COPILOT_QUEUE_OVERFLOW_STRATEGY=drop_oldest

# ─────────────────────────────────────────────────────────────────────────
# app.main — audio pipeline (STT + diarization). Required to run this service.
# ─────────────────────────────────────────────────────────────────────────
# There is no offline/mock mode for either of these. Both MUST be
# "production" and both credentials MUST be set, or startup raises with an
# explanatory error (app/core/config.py `validate_provider_mode`). An earlier
# development mode silently fabricated transcripts and speaker labels; it was
# deleted rather than left as a footgun.

CLINICAL_COPILOT_STT_PROVIDER_MODE=production
CLINICAL_COPILOT_ELEVENLABS_API_KEY=

CLINICAL_COPILOT_DIARIZATION_MODE=production
CLINICAL_COPILOT_HUGGINGFACE_TOKEN=

# Tuning for the diarization sliding window. Defaults are usually fine.
# CLINICAL_COPILOT_DIARIZATION_BUFFER_SECONDS=7
# CLINICAL_COPILOT_DIARIZATION_WINDOW_SECONDS=5
# CLINICAL_COPILOT_DIARIZATION_INTERVAL_SECONDS=2

# Writes a full word-by-word transcript dump to logs/diarization_debug_{id}.json
# for every diarized turn. Diagnostic only — leave this off. `logs/` is
# git-ignored specifically because this flag has, in the past, been left on.
CLINICAL_COPILOT_DIARIZATION_DEBUG=False

# ─────────────────────────────────────────────────────────────────────────
# Clinical reasoning — optional LLM enrichment (clinical_intelligence/)
# ─────────────────────────────────────────────────────────────────────────
# Without a key, llm_status in the reasoning response reports "unavailable"
# and the llm_* fields are empty. Nothing is fabricated in their place. The
# deterministic rule engine (diagnoses, red flags, investigations) works with
# no key at all.
GEMINI_API_KEY=
OPENAI_API_KEY=

CLINICAL_COPILOT_ENABLE_LLM=True
# Red flags are always detected; this controls whether they're included in
# the /v1/clinical-reasoning response.
CLINICAL_COPILOT_ENABLE_RED_FLAG_ALERTS=True
CLINICAL_COPILOT_ENABLE_EMERGENCY_WORKFLOW=False

# Optional knowledge-graph enrichment. Degrades cleanly (graph_status: DOWN)
# when unset or unreachable.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────
# Copilot API service (copilot_api/). Every value below is optional — with
# none of them set, the service starts, serves the full deterministic
# clinical API, and reports no intelligence.
# ─────────────────────────────────────────────────────────────────────────

# Master switch for the intelligence layer. Off means no worker thread and
# no model client is constructed at all.
COPILOT_INTELLIGENCE_ENABLED=false

# null | deterministic | langgraph.
# `deterministic` restates rule output and calls no model - useful for
# exercising the whole path in an environment with no API key.
COPILOT_INTELLIGENCE_PROVIDER=langgraph

# gemini | openai. Only consulted when the provider is `langgraph`.
# The key itself comes from GEMINI_API_KEY / OPENAI_API_KEY above.
COPILOT_MODEL_PROVIDER=gemini
COPILOT_MODEL_NAME=
COPILOT_MODEL_TEMPERATURE=0.2

# Advisory. A synchronous provider cannot be interrupted, only measured, so
# this marks a snapshot as late rather than cancelling it.
COPILOT_INTELLIGENCE_BUDGET_MS=8000

# How many consultations keep their latest snapshot in memory.
COPILOT_INTELLIGENCE_CAPACITY=256

# Idle consultations are evicted after this long.
COPILOT_SESSION_IDLE_TIMEOUT_SECONDS=1800

# The service refuses to start when CLINICAL_COPILOT_JWT_SECRET_KEY is still
# the placeholder above. Set this only for local development.
COPILOT_ALLOW_INSECURE_AUTH=false

# ─────────────────────────────────────────────────────────────────────────
# Copilot bridge — forwards finalized transcripts from app.main to
# copilot_api. This is what connects "audio was transcribed" to "the Copilot
# service has clinical facts for it." Off by default: with
# COPILOT_BRIDGE_ENABLED unset, app.main behaves exactly as if this bridge
# did not exist.
# ─────────────────────────────────────────────────────────────────────────
COPILOT_BRIDGE_ENABLED=false
# Where app.main should reach the copilot_api service.
COPILOT_BRIDGE_BASE_URL=http://127.0.0.1:8010
COPILOT_BRIDGE_TIMEOUT_SECONDS=10
