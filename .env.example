# Clinical Consultation Copilot Environment Configurations

# JWT Configuration
CLINICAL_COPILOT_JWT_SECRET_KEY=production-jwt-secret-key-change-me
CLINICAL_COPILOT_JWT_ALGORITHM=HS256

# Queue Configurations
CLINICAL_COPILOT_QUEUE_MAX_SIZE=100
CLINICAL_COPILOT_QUEUE_OVERFLOW_STRATEGY=drop_oldest

# ElevenLabs Speech-to-Text API Key
CLINICAL_COPILOT_ELEVENLABS_API_KEY=
# STT Mode: development (offline mocks) or production (live ElevenLabs WebSocket)
CLINICAL_COPILOT_STT_PROVIDER_MODE=development

# Hugging Face Access Token (required for Pyannote gated repositories)
CLINICAL_COPILOT_HUGGINGFACE_TOKEN=
# Diarization Mode: development (offline mocks) or production (live Pyannote model)
CLINICAL_COPILOT_DIARIZATION_MODE=development

# ─────────────────────────────────────────────────────────────────────────
# Copilot API service
# ─────────────────────────────────────────────────────────────────────────
# Every value below is optional. With none of them set the service starts,
# serves the full deterministic clinical API, and reports no intelligence.

# Master switch for the intelligence layer. Off means no worker thread and
# no model client is constructed at all.
COPILOT_INTELLIGENCE_ENABLED=false

# null | deterministic | langgraph.
# `deterministic` restates rule output and calls no model - useful for
# exercising the whole path in an environment with no API key.
COPILOT_INTELLIGENCE_PROVIDER=langgraph

# gemini | openai. Only consulted when the provider is `langgraph`.
# The key itself comes from GEMINI_API_KEY / OPENAI_API_KEY above.
COPILOT_MODEL_PROVIDER=gemini
COPILOT_MODEL_NAME=
COPILOT_MODEL_TEMPERATURE=0.2

# Advisory. A synchronous provider cannot be interrupted, only measured, so
# this marks a snapshot as late rather than cancelling it.
COPILOT_INTELLIGENCE_BUDGET_MS=8000

# How many consultations keep their latest snapshot in memory.
COPILOT_INTELLIGENCE_CAPACITY=256

# Idle consultations are evicted after this long.
COPILOT_SESSION_IDLE_TIMEOUT_SECONDS=1800

# The service refuses to start when CLINICAL_COPILOT_JWT_SECRET_KEY is still
# the placeholder above
# shipped in app/core/config.py - that secret is public, so any caller could
# mint a token for any consultation. Set this only for local development.
COPILOT_ALLOW_INSECURE_AUTH=false
